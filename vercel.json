{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "env": {
    "BACKEND_URL": "@backend_url",
    "NEXT_PUBLIC_API_URL": "@next_public_api_url",
    "API_SECRET": "@api_secret"
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
